exports[`HTML storyshots Core/Course/Module Assignment 1`] = `
<storybook-dynamic-app-root
  cfr={[Function CodegenComponentFactoryResolver]}
  data={[Function Object]}
  target={[Function ViewContainerRef_]}
>
  <core-course-module>
    
    <ion-card>
      
      
      <ion-item
        aria-label="Assignment"
        class="ion-text-wrap core-course-module-handler core-module-main-item addon-mod_assign-handler"
        detail="false"
        id="core-course-module-2"
      >
        
        <core-mod-icon
          slot="start"
        >
          
          
          <img
            alt="Assignment"
            class="core-module-icon"
            src="assets/img/mod/assign.svg"
          />
        </core-mod-icon>
        <ion-label
          class="core-module-title"
        >
          <p
            class="item-heading"
          >
            <core-format-text
              aria-label="Assignment, Assignment"
              class="core-loading"
              contextlevel="module"
              singleline="false"
            >
               
            </core-format-text>
            
            
          </p>
          <div
            class="core-module-additional-info"
          >
            
            <core-course-module-completion
              mode="basic"
            >
              
              
              
              
              <core-course-module-manual-completion>
                
                
                
                
                
                
                <ion-button
                  aria-label="Mark Assignment as done"
                  class="ion-text-wrap chip"
                  fill="outline"
                >
                   core.course.completion_manual:markdone 
                  
                </ion-button>
                
                
                
              </core-course-module-manual-completion>
              
            </core-course-module-completion>
            
            
            
          </div>
        </ion-label>
        
        <div
          class="buttons core-module-buttons"
          slot="end"
        >
          
          <div
            class="core-module-buttons-more"
          >
            
          </div>
        </div>
      </ion-item>
      
      
      
      
    </ion-card>
  </core-course-module>
</storybook-dynamic-app-root>
`;

